{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/"
    },
    {
      "source": "/app/signup",
      "destination": "/"
    },
    {
      "source": "/app/confirm",
      "destination": "/"
    },
    {
      "source": "/terms.html",
      "destination": "/"
    },
    {
      "source": "/privacy.html",
      "destination": "/"
    },
    {
      "source": "/recording-consent.html",
      "destination": "/"
    },
    {
      "source": "/status.html",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://api.deepgram.com wss://agent.deepgram.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self), payment=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=()"
        }
      ]
    },
    {
      "source": "/app/confirm",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=()"
        }
      ]
    },
    {
      "source": "/app/signup",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=()"
        }
      ]
    },
    {
      "source": "/terms.html",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=()"
        }
      ]
    },
    {
      "source": "/privacy.html",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=()"
        }
      ]
    },
    {
      "source": "/recording-consent.html",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=()"
        }
      ]
    },
    {
      "source": "/status.html",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=()"
        }
      ]
    }
  ]
}
