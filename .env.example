# Required. One of: openrouter, grok, anthropic, openai, deepseek, meta, google
# openrouter/grok routes through the launch catalog; the free-tier default is Grok.
CONCH_PROVIDER=openrouter

# Required when CONCH_PROVIDER=anthropic (native Anthropic API).
ANTHROPIC_API_KEY=sk-ant-...

# Required when CONCH_PROVIDER=openai (native OpenAI Chat Completions API).
OPENAI_API_KEY=sk-proj-...

# Optional alternative to OPENAI_API_KEY. Path to a file containing only the key.
OPENAI_API_KEY_FILE=~/build/solving/openai

# Required when CONCH_PROVIDER is openrouter/grok, deepseek, meta, or google (routes through OpenRouter).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Raises GitHub API rate limits when the agent uses the github tool.
GITHUB_TOKEN=ghp_...

# Optional. Force a specific live output device by matching part of its name or driver
# (for example: pulse, pipewire, hdmi, speakers).
CONCH_OUTPUT_DEVICE=

# Required when CONCH_STT=deepgram or CONCH_TTS=deepgram
# (server-side only; never expose this key to browsers).
DEEPGRAM_API_KEY=dg-...

# Recommended for the Vercel browser trial/token broker. Server-side only.
# If omitted, the broker falls back to DEEPGRAM_API_KEY when Deepgram voice is configured.
CONCH_SESSION_SIGNING_SECRET=replace-with-random-32-byte-secret

# Required when CONCH_TTS=elevenlabs
ELEVENLABS_API_KEY=el-...

# Optional. deepgram (default) | local
CONCH_STT=deepgram

# Optional. deepgram | elevenlabs | local (default) | text
CONCH_TTS=local

# Optional. Deepgram Aura voice/model used when CONCH_TTS=deepgram
CONCH_DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Email confirmation for browser trials. Required in production for /api/trial-signup.
RESEND_API_KEY=
CONCH_EMAIL_FROM=Conch <conch@theos.sh>
CONCH_PUBLIC_APP_URL=https://[redacted-preview-host]

# Durable usage metering for free trials. Vercel KV / Upstash Redis REST env names are supported.
KV_REST_API_URL=
KV_REST_API_TOKEN=
CONCH_TRIAL_USER_BUDGET_CENTS=1000
CONCH_FREE_TRIAL_GLOBAL_BUDGET_CENTS=1000000
CONCH_TRIAL_TOKEN_RESERVATION_CENTS=100
