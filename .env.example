# Required. One of: openrouter, grok, anthropic, openai, deepseek, meta, google
# openrouter/grok routes through the launch catalog; the free-tier default is Grok.
CONCH_PROVIDER=openrouter

# Required when CONCH_PROVIDER=anthropic (native Anthropic API).
ANTHROPIC_API_KEY=sk-ant-...

# Required when CONCH_PROVIDER=openai (native OpenAI Chat Completions API).
OPENAI_API_KEY=sk-proj-...

# Optional alternative to OPENAI_API_KEY. Path to a file containing only the key.
OPENAI_API_KEY_FILE=~/build/solving/openai

# Required when CONCH_PROVIDER is openrouter/grok, deepseek, meta, or google (routes through OpenRouter).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Raises GitHub API rate limits when the agent uses the github tool.
GITHUB_TOKEN=ghp_...

# Optional. Force a specific live output device by matching part of its name or driver
# (for example: pulse, pipewire, hdmi, speakers).
CONCH_OUTPUT_DEVICE=

# Required when CONCH_STT=deepgram
DEEPGRAM_API_KEY=dg-...

# Required when CONCH_TTS=elevenlabs
ELEVENLABS_API_KEY=el-...

# Optional. deepgram (default) | local
CONCH_STT=deepgram

# Optional. elevenlabs (default) | local | text
CONCH_TTS=elevenlabs
