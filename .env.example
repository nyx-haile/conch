# Required. One of: anthropic, deepseek, meta, google
CONCH_PROVIDER=anthropic

# Required when CONCH_PROVIDER=anthropic (native Anthropic API).
ANTHROPIC_API_KEY=sk-ant-...

# Required when CONCH_PROVIDER is anything other than anthropic (routes through OpenRouter).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Raises GitHub API rate limits when the agent uses the github tool.
GITHUB_TOKEN=ghp_...
